# CTI-RLex public-repository allowlist
#
# Everything at the repository root is private by default. Only what a reader or reviewer
# needs in order to rerun the study and check its numbers is allowed below: the software,
# the two benchmark packages with their provenance, the experiment scripts named in the
# Data Availability Statement, the result files those scripts write, and the tests.
#
# Deliberately NOT published: the manuscript and its working files (Paper/), the reference
# PDFs (references/, publisher copyright), the internal planning and audit notes, the model
# working document, and every local build product.

/*

# ---------------------------------------------------------------- repository metadata
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE.*
!/CITATION.cff
!/CHANGELOG.md
!/CONTRIBUTING.md
!/requirements-lock.txt
!/.github/
!/.github/**

# ---------------------------------------------------------------- application and package
!/main.py
!/pyproject.toml
!/requirements.txt
!/src/
!/src/**

# ---------------------------------------------------------------- reproducibility tests
!/tests/
!/tests/**

# ---------------------------------------------------------------- benchmark packages
# Both instances are published in full: the canonical benchmark.json, the normalized CSV
# layers behind it, the generator, the validation report and the SHA-256 checksums.
!/DATA/
/DATA/*
!/DATA/LittleBearRiver_2025_Benchmark/
!/DATA/LittleBearRiver_2025_Benchmark/**
!/DATA/CacheValley_2025_Benchmark/
!/DATA/CacheValley_2025_Benchmark/**
!/DATA/benchmarks_dag/
!/DATA/benchmarks_dag/**
# The 2025 River Commissioner records at the five stations of the three-claimant instance,
# with their provenance. Observations for comparison only; no benchmark reads them.
!/DATA/LittleBearRiver_2025_Observations/
!/DATA/LittleBearRiver_2025_Observations/**
# The points of diversion of the water rights the two benchmarks name, from the Utah Division
# of Water Rights, with their provenance. Read by the priority comparator only.
!/DATA/Utah_Water_Rights_2026/
!/DATA/Utah_Water_Rights_2026/**
# The monthly discharge of USGS gauge 10105900, Little Bear River at Paradise, with its
# provenance. Read by the historical reliability test only.
!/DATA/USGS_10105900_LittleBearRiver/
!/DATA/USGS_10105900_LittleBearRiver/**

# ---------------------------------------------------------------- experiment scripts
# Only the scripts that produce published numbers and figures, plus the shared timing
# protocol they all import. The manuscript-authoring tools in this directory operate on
# the Word files and are working code, not results.
!/scripts/
/scripts/*
!/scripts/timing_protocol.py
!/scripts/rerun_all_results.py
!/scripts/run_cti_rlex.py
!/scripts/run_cti_experiments.py
!/scripts/run_cti_verification.py
!/scripts/revision_experiments.py
!/scripts/ablation_experiment.py
!/scripts/scalability_experiment.py
!/scripts/equal_budget_experiment.py
!/scripts/restriction_threshold_experiment.py
!/scripts/create_results_artifacts.py
!/scripts/draw_figure2_workflow.py
!/scripts/update_figure4_two_panel.py
!/scripts/verify_publication_figures.py
!/scripts/record_environment.py
!/scripts/connector_order_experiment.py
!/scripts/excluded_service_areas.py
!/scripts/normalization_sensitivity.py
!/scripts/factorial_decomposition.py
!/scripts/component_analysis.py
!/scripts/cache_valley_audit.py
!/scripts/benchmark_parameter_tables.py
!/scripts/path_reading_table.py
# The third reviewer's measurements: optimality certificates and the tolerance grid,
# what the objective hierarchy determines, and monotone realization across scenarios.
!/scripts/numerical_certificates.py
!/scripts/flow_uniqueness.py
!/scripts/monotone_realization.py
# Downloads the Utah points of diversion behind the priority comparator (Reviewer 1, 2.1).
!/scripts/fetch_wrpod.py
# Sets the three-claimant instance against the canal flows measured in 2025 (Reviewer 1, 2.2).
!/scripts/station_comparison.py
# Re-solves it with each claimant's demand set to its measured 2025 diversion (Reviewer 1, 2.2).
!/scripts/observed_demand_sensitivity.py
# Copies the points of diversion of the rights the benchmarks name into DATA/ (Reviewer 1, 2.1).
!/scripts/extract_water_rights.py
# CTI-RLex subordinated to the decree priority of those rights, PRIOR-LEX (Reviewer 1, 2.1).
!/scripts/prior_lex.py
# The published plan held fixed against unseen scenarios (Reviewer 1, 1.2): the shared helper,
# the convex hull of the scenarios, and the river's seasons of 1993 to 2025.
!/scripts/fixed_plan_recourse.py
!/scripts/robust_vertex_check.py
!/scripts/historical_reliability.py
# Both instances with canal conveyance losses two, four and six times the published rate
# (Reviewer 2; Reviewer 1, 1.4), and PRIOR-LEX with tiers assigned to rights (Reviewer 1, 2.1).
!/scripts/conveyance_loss_levels.py
!/scripts/prior_lex_rights.py
# The two-pass driver for the county benchmark. Not an experiment script, but the
# README and the manuscript tell a reader to run it, so it has to be in the release.
!/scripts/rebuild_cache_valley.py

# ---------------------------------------------------------------- published results
# The files the manuscript and the Supplementary Material cite by name, plus the tables
# and figures built from them.
!/results/
/results/*
!/results/*.json
!/results/discrimination/
!/results/discrimination/**
!/results/tables/
!/results/tables/**
!/results/figures/
!/results/figures/**

# ---------------------------------------------------------------- re-excluded everywhere
# These rules come last so they win over the allowances above.

# Uzbek-labelled working copies of published figures
*_uz.*

# Editor backups and generator scratch
*.bak
*.orig
*.rej

# Python bytecode and tool caches
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Local environments and packaging products
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# IDE, OS, log and temporary files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.temp
~$*

# GUI result packages are generated locally and must not be committed
cti_rlex_export_*/
